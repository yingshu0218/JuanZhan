{
  "name": "juanzhan-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/copy-pdf-assets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:e2e:sources": "playwright test --config sources.playwright.config.mjs",
    "test:e2e:reading": "playwright test --config reading.playwright.config.mjs",
    "test:e2e:search": "playwright test --config search.playwright.config.mjs",
    "test:e2e:jobs": "playwright test --config jobs.playwright.config.mjs",
    "test:e2e:files": "playwright test --config files.playwright.config.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.2"
  }
}
